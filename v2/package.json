{
  "name": "kena",
  "version": "0.0.1",
  "description": "Mirror del repositorio de git del bot KenaBot",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc && echo Bot complilado correctamente",
    "dev": "ts-node-dev --respawn --transpile-only --poll main.ts",
    "devs": "ts-node-dev --respawn --transpile-only --poll shards.ts",
    "test": "eslint .",
    "config": "npm i && node cli/main.js && tsc"
  },
  "keywords": [
    "discord-bot",
    "music-bot",
    "kenamusic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holasoyender/Kena.git"
  },
  "author": "holasoyender",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/holasoyender/Kena/issues"
  },
  "homepage": "https://kenabot.xyz",
  "devDependencies": {
    "@types/chalk": "2.2.0",
    "@types/express": "4.17.13",
    "@types/request-promise": "4.1.48",
    "@types/uuid": "8.3.4",
    "@typescript-eslint/eslint-plugin": "5.33.0",
    "@typescript-eslint/parser": "5.33.0",
    "eslint": "8.21.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "@discordjs/builders": "^1.1.0",
    "@sentry/node": "^7.10.0",
    "@sentry/tracing": "^7.10.0",
    "axios": "^0.27.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "delay": "^5.0.0",
    "discord-hybrid-sharding": "^1.7.1",
    "discord.js": "^13.10.2",
    "dotenv": "^16.0.1",
    "inquirer": "^9.1.0",
    "js-base64": "^3.7.2",
    "moment": "^2.29.4",
    "mongoose": "6.5.2",
    "nanospinner": "^1.1.0",
    "petitio": "^1.4.0",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "undici": "^5.8.2"
  }
}